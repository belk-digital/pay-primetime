# PayPrimeTime runs at https://payprimetime.com. Copy to .env.local for local work; on the host add the same
# names under the project's environment variables (Production), then redeploy: changes only apply to new builds.

# --- Stripe: the account that receives the money. TEST keys (sk_test_ / pk_test_) until go-live.
# Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally:
#   stripe listen --forward-to localhost:3100/api/webhooks/stripe
# In production add the endpoint https://payprimetime.com/api/webhooks/stripe in the Dashboard (events:
# payment_intent.succeeded, payment_intent.payment_failed, charge.refunded). Test and live each have their own.
STRIPE_WEBHOOK_SECRET=

# --- The store that uses this payment page (the only one).
# Shown to customers on the payment page. It has to be the real seller.
SHOP_NAME=
# Where customers are returned, and where status pings go ({SHOP_URL}/api/webhooks/payprimetime).
SHOP_URL=
# Other addresses of the same store customers may be returned to, comma separated. Customers are only ever
# sent back to a listed address, so include the www/non-www variant and any preview address you test from.
SHOP_ALT_URLS=
# Optional. Shown to customers on the payment page.
SHOP_SUPPORT_EMAIL=
# Optional. Shown on the payment page; what appears on a card statement is set in the Stripe Dashboard
# (Settings -> Business -> Public details), so keep the two the same.
SHOP_STATEMENT_DESCRIPTOR=
# Optional. Overrides where status pings go (default {SHOP_URL}/api/webhooks/payprimetime).
SHOP_WEBHOOK_URL=
# Shared secret between this site and the store. The SAME value goes in the store's environment (same name).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYPRIMETIME_API_SECRET=

# --- This site
NEXT_PUBLIC_SITE_URL=https://payprimetime.com
# Optional. Falls back to support@payprimetime.com. Must be a mailbox that exists.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional. Who operates the service, shown on the Terms and Privacy pages only when set (leave both empty
# to omit the line). Use the registered business name and address.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
# "true" turns on the real Stripe payment page. Anything else shows the design preview (sample order, nothing is
# charged). Changing it needs a rebuild/restart.
NEXT_PUBLIC_PAYMENTS_LIVE=false
